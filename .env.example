# ==============================================================================
# ORCA Marine Intelligence Platform Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CLIENT VARIABLES (Exposed to Browser via Vite bundle)
# ------------------------------------------------------------------------------
# CARTO Basemaps API Key (https://carto.com/basemaps/apikey)
VITE_CARTO_API_KEY=your_carto_api_key_here

# OpenWeather API Key (https://openweathermap.org/api)
OPENWEATHER_API_KEY=

# Mapbox Access Token (https://account.mapbox.com)
VITE_MAPBOX_TOKEN=pk.your_mapbox_token_here

# NASA FIRMS MAP Key (https://firms.modaps.eosdis.nasa.gov/api/map_key)
VITE_NASA_FIRMS_MAP_KEY=your_nasa_firms_key_here

# ------------------------------------------------------------------------------
# BACKEND SERVER-SIDE SECRETS (Never prefix with VITE_)
# ------------------------------------------------------------------------------
# PostgreSQL Database URL (Prisma ORM)
DATABASE_URL="postgresql://user:password@localhost:5432/orca?schema=public"

# AI Inference (NVIDIA NIM)
NVIDIA_NIM_API_KEY=nvapi-your_key_here
NVIDIA_NIM_MODEL=meta/llama-3.2-11b-vision-instruct

# Hugging Face API Token (optional)
HUGGINGFACE_API_KEY=hf_your_key_here

# Bhashini ULCA Voice API (optional)
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=

# Copernicus Marine Data Store (optional)
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# JWT Authentication Secret
JWT_SECRET=your_secure_random_jwt_secret_key_here