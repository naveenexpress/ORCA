generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(uuid())
  name              String
  email             String   @unique
  passwordHash      String?
  role              String
  avatar            String?
  phone             String?
  organization      String?
  assignedRegion    String?
  district          String?
  landingCentre     String?
  baseLocationName  String?
  preferredLanguage String   @default("en")
  isDemoAccount     Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model PfzAdvisory {
  id                         String  @id @default(uuid())
  advisoryId                 String  @unique
  name                       String
  status                     String
  source                     String
  sourceUrlOrReference       String?
  publishedAt                String
  validFrom                  String
  validUntil                 String
  lastUpdatedAt              String
  region                     String
  state                      String
  district                   String
  sector                     String
  landingCentreId            String
  landingCentreName          String
  latitude                   Float
  longitude                  Float
  polygonCoordinates         Json?
  depth                      Float
  depthFathoms               Float?
  distanceFromLandingCentre  Float
  distanceKm                 Float
  directionFromLandingCentre String
  bearingDegrees             Float
  seaSurfaceTemperature      Float
  chlorophyll                Float
  confidence                 String
  description                String
  targetSpecies              Json
  languageVariants           Json?
  version                    Int
  createdBy                  String
  approvedBy                 String?
  createdAt                  String
  updatedAt                  String
  isSimulated                Boolean @default(false)
}

model Agent {
  id               String   @id @default(uuid())
  name             String
  badgeNumber      String
  avatar           String?
  phone            String
  email            String   @unique
  organization     String
  state            String
  district         String
  baseLocationName String
  coordinates      Json
  languages        Json
  skills           Json
  certifications   Json
  experienceYears  Int
  assignedZoneIds  Json
  status           String
  currentWorkload  Int
  maxWorkload      Int
  performance      Json
  gpsConsent       Boolean
  lastActive       String
  deviceSyncStatus String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model OperationalZone {
  id                 String   @id @default(uuid())
  name               String
  code               String   @unique
  zoneType           String
  description        String
  polygon            Json
  priority           String
  capacity           Int
  status             String
  primaryAgentId     String
  backupAgentId      String?
  escalationAgentId  String?
  assignedAgentIds   Json
  supportedLanguages Json
  state              String
  district           String
  currentActiveCases Int
  version            Int
  updatedAt          String
  createdAt          DateTime @default(now())
}

model Case {
  id                   String           @id @default(uuid())
  caseNumber           String           @unique
  requesterName        String
  requesterContact     String
  requesterRole        String
  requestType          String
  title                String
  description          String
  locationName         String
  coordinates          Json
  region               String
  language             String
  priority             String
  status               String
  assignedAgentId      String?
  assignedAgentName    String?
  assignedSupervisorId String?
  relatedPfzId         String?
  slaDueTime           String
  escalationLevel      Int
  createdAt            String
  updatedAt            String
  closedAt             String?
  closureReason        String?
  feedbackRating       Int?
  feedbackNotes        String?
  attachments          CaseAttachment[]
  comments             CaseComment[]
}

model CaseComment {
  id         String  @id @default(uuid())
  caseId     String
  authorId   String
  authorName String
  authorRole String
  text       String
  createdAt  String
  isInternal Boolean @default(false)
  case       Case    @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model CaseAttachment {
  id         String @id @default(uuid())
  caseId     String
  name       String
  type       String
  url        String
  uploadedAt String
  case       Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model FieldTask {
  id              String  @id @default(uuid())
  taskId          String  @unique
  caseId          String
  agentId         String
  agentName       String
  title           String
  description     String
  priority        String
  status          String
  locationName    String
  coordinates     Json
  dueTime         String
  rejectionReason String?
  notes           Json
  attachments     Json
  createdAt       String
  updatedAt       String
}

model SosIncident {
  id                        String  @id @default(uuid())
  incidentCode              String  @unique
  callerName                String
  callerPhone               String
  vesselRegNumber           String?
  emergencyType             String
  peopleAffectedCount       Int
  severity                  String
  status                    String
  coordinates               Json
  locationDescription       String
  nearestLandingCentre      String
  distanceFromShoreKm       Float
  assignedAgentIds          Json
  assignedSupervisorId      String
  disasterAuthorityNotified Boolean @default(false)
  coastGuardCaseRef         String?
  timeline                  Json
  mediaAttachments          Json?
  createdAt                 String
  updatedAt                 String
}

model Notification {
  id                String  @id @default(uuid())
  type              String
  title             String
  message           String
  severity          String
  recipientRole     String?
  recipientId       String?
  relatedRecordType String?
  relatedRecordId   String?
  isRead            Boolean @default(false)
  createdAt         String
}

model Vessel {
  id                 String             @id @default(uuid())
  registrationNumber String             @unique
  name               String
  ownerName          String
  contactPhone       String
  vesselType         String?
  homePort           String?
  voyages            Voyage[]
  emergencyContacts  EmergencyContact[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model EmergencyContact {
  id           String  @id @default(uuid())
  vesselId     String
  vessel       Vessel  @relation(fields: [vesselId], references: [id], onDelete: Cascade)
  name         String
  phone        String
  relationship String?
}

model Voyage {
  id                    String               @id @default(uuid())
  vesselId              String
  vessel                Vessel               @relation(fields: [vesselId], references: [id], onDelete: Cascade)
  status                String
  departureTime         DateTime
  expectedReturnTime    DateTime
  actualReturnTime      DateTime?
  destinationArea       String?
  crewCount             Int                  @default(1)
  lastLocationLat       Float?
  lastLocationLng       Float?
  lastLocationTime      DateTime?
  lastCommunicationTime DateTime?
  safetyCheckIns        SafetyCheckIn[]
  communicationEvents   CommunicationEvent[]
  safetyAlerts          SafetyAlert[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
}

model SafetyCheckIn {
  id        String   @id @default(uuid())
  voyageId  String
  voyage    Voyage   @relation(fields: [voyageId], references: [id], onDelete: Cascade)
  timestamp DateTime @default(now())
  latitude  Float?
  longitude Float?
  status    String
  notes     String?
}

model CommunicationEvent {
  id        String   @id @default(uuid())
  voyageId  String
  voyage    Voyage   @relation(fields: [voyageId], references: [id], onDelete: Cascade)
  timestamp DateTime @default(now())
  type      String
  status    String
  notes     String?
}

model SafetyAlert {
  id              String    @id @default(uuid())
  voyageId        String
  voyage          Voyage    @relation(fields: [voyageId], references: [id], onDelete: Cascade)
  type            String
  severity        String
  status          String
  timestamp       DateTime  @default(now())
  resolvedAt      DateTime?
  resolutionNotes String?
}
